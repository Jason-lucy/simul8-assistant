generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  USER
  ADMIN
}

enum DocStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  role         Role           @default(USER)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  llmConfig    UserLlmConfig?
  sessions     ChatSession[]
}

model UserLlmConfig {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseUrl         String
  apiKeyEncrypted String
  apiKeyLast4     String
  model           String
  updatedAt       DateTime @updatedAt
}

model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  maxUses   Int       @default(1)
  usedCount Int       @default(0)
  createdBy String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

model Document {
  id        String     @id @default(cuid())
  title     String
  source    String?
  mimeType  String?
  content   String
  status    DocStatus  @default(PENDING)
  errorMsg  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  chunks    Chunk[]
}

model Chunk {
  id         String                       @id @default(cuid())
  documentId String
  document   Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String
  chunkIndex Int
  // Stored via raw SQL as vector(1536); Prisma keeps a float array mirror for reading
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                     @default(now())

  @@index([documentId])
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String        @default("新对话")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  citations Json?
  createdAt DateTime    @default(now())

  @@index([sessionId])
}
