# Database (local Docker Compose default)
DATABASE_URL="postgresql://simul8:simul8@localhost:5432/simul8?schema=public"

# 32+ char secret used to encrypt user API keys at rest
ENCRYPTION_SECRET="change-me-to-a-long-random-string-at-least-32"

# JWT session signing secret
AUTH_SECRET="change-me-auth-secret-at-least-32-chars"

# Bootstrap admin (created on first seed)
ADMIN_EMAIL="admin@company.local"
ADMIN_PASSWORD="ChangeMeAdmin123!"
ADMIN_NAME="Admin"

# First invite code for colleagues (created on seed if missing)
BOOTSTRAP_INVITE_CODE="SIMUL8-WELCOME"

# Company shared Embedding API (OpenAI-compatible). Used only for ingest + retrieval.
EMBEDDING_BASE_URL="https://api.openai.com/v1"
EMBEDDING_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"
# Must match vector(1536) in Prisma schema for OpenAI text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Optional: if embedding is not configured, keyword search fallback is used
ALLOW_KEYWORD_FALLBACK=true
